<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>JohnVo.ProjectTemplates</PackageId>
    <Version>1.8.9</Version>
    <Authors>JohnVo</Authors>
    <Description>JohnVo .NET 8+ DDD + Clean Architecture + Vertical Slice/CQRS template with always-on Specification and UnitOfWork, Minimal APIs, permission auth, optional Redis/MinIO, optional LHS filtering, Orval frontends, and pluggable AI with Gemini by default, CI tests, tag-only GHCR publishing, and production compose rollback tags, separate EF migrations tooling, and just task automation, automatic fail-fast startup migrations, service-targetable Docker just recipes, always-on FluentValidation, VietWash-style Models/Projections with repository mapping expressions, profile/avatar flows, paginated Todos, Docker Compose environment alias mapping, and polished feature-oriented React/Angular starter code.</Description>
    <PackageTags>dotnet-new;template;clean-architecture;vertical-slice;ddd;specification;unit-of-work;redis;minio;ai;gemini;openai;filtering;pagination;minimal-api;jwt;refresh-token;orval;github-actions;ghcr;docker-compose;just;ef-migrations;auto-migrate;feature-sliced-frontend</PackageTags>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**" />
    <Compile Remove="**/*" />
  </ItemGroup>
</Project>
