# Development Docker Compose variables for TemplateApp.
# Generated only when --docker true. Copy this file to `.env` and adjust values as needed.
# Docker Compose reads `.env` for interpolation and maps these aliases to canonical ASP.NET environment keys.
# The .NET backend does not parse this file directly.

AUTO_MIGRATE=true

# Database container password. Leave blank to use the provider-specific development default from compose.yaml.
DB_PASSWORD=

# JWT / refresh-token auth
JWT_ISSUER=TemplateApp
JWT_AUDIENCE=TemplateApp.Client
JWT_KEY=TemplateApp-development-only-key-change-me-1234567890
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=refresh_token

# Redis (only when --redis true)
REDIS_INSTANCE_NAME=TemplateApp:

# MinIO (only when --minio true)
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=templateapp
MINIO_PRESIGNED_EXPIRY_SECONDS=900

# Gemini (default when --ai gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (only when --ai openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Aspire / OpenTelemetry (only when --otel true).
# Docker Compose starts the Aspire Dashboard and the API sends OTLP to it by default.
OTEL_SERVICE_NAME=TemplateApp.Api
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=
