Database__AutoMigrate=true
# GHCR image prefix created by the tag release workflow.
# Example: ghcr.io/johnvo/my-project
GHCR_IMAGE_PREFIX=ghcr.io/OWNER/REPOSITORY

# prod is updated only when a Git tag is pushed. For rollback set IMAGE_TAG to a full commit SHA.
IMAGE_TAG=prod
FRONTEND_PORT=80
API_PORT=8080

# MinIO API is public only when MinIO is generated because browser avatar download URLs need it.
MINIO_API_PORT=9000
# Direct host-port example: server.example.com:9000 + false.
# If a TLS reverse proxy routes storage.example.com:443 to MinIO, use storage.example.com + true.
MINIO_PUBLIC_ENDPOINT=server.example.com:9000
MINIO_PUBLIC_SECURE=false

DB_PASSWORD=change-me
JWT_KEY=replace-with-a-long-random-production-secret

# Optional integrations. Either SCREAMING_SNAKE_CASE or .NET section style works.
GEMINI_API_KEY=
GEMINI_MODEL=
# Gemini__ApiKey=
# Gemini__Model=
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI__ApiKey=
# OpenAI__Model=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=templateapp
