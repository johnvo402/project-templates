AUTO_MIGRATE=true

# GHCR image prefix created by the tag release workflow.
# Example: ghcr.io/johnvo/my-project
GHCR_IMAGE_PREFIX=ghcr.io/OWNER/REPOSITORY

# prod is updated only when a Git tag is pushed. For rollback set IMAGE_TAG to a full commit SHA.
IMAGE_TAG=prod
FRONTEND_PORT=80
API_PORT=8080

# Database container password. Bundled compose uses its internal service hostname.
DB_PASSWORD=ChangeMe!123456

# JWT / refresh-token auth
JWT_ISSUER=TemplateApp
JWT_AUDIENCE=TemplateApp.Client
JWT_KEY=replace-with-a-long-random-production-secret
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=refresh_token

# Redis (only when --redis true). Leave blank to use the bundled redis service.
REDIS_CONNECTION=
REDIS_INSTANCE_NAME=TemplateApp:

# MinIO API is public only when MinIO is generated because browser avatar download URLs need it.
MINIO_API_PORT=9000
MINIO_PUBLIC_ENDPOINT=server.example.com:9000
MINIO_PUBLIC_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=ChangeMeToo!123
MINIO_BUCKET=templateapp
MINIO_PRESIGNED_EXPIRY_SECONDS=900

# Optional AI integrations.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
