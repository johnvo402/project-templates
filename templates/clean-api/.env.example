# Development environment example for TemplateApp.
# Copy this file to `.env` and adjust values for your machine.
# Docker Compose reads `.env` automatically.
# The generated API also loads this file before WebApplication.CreateBuilder for local development.
# Existing OS environment variables win over values in this file.

ASPNETCORE_ENVIRONMENT=Development
Database__AutoMigrate=true

# Database: uncomment the one matching the generated project.
# SQL Server
# ConnectionStrings__Default=Server=localhost,1433;Database=TemplateApp;User Id=sa;Password=TemplateStrong!123;TrustServerCertificate=True
# PostgreSQL
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=TemplateApp;Username=postgres;Password=postgres

# JWT / refresh-token auth
Jwt__Issuer=TemplateApp
Jwt__Audience=TemplateApp.Client
Jwt__Key=TemplateApp-development-only-key-change-me-1234567890
Jwt__ExpirationMinutes=15
Auth__RefreshTokenDays=14
Auth__RefreshCookieName=refresh_token

# Redis (only when --redis true)
# Redis__Configuration=localhost:6379
# Redis__InstanceName=TemplateApp:

# MinIO (only when --minio true)
# Minio__Endpoint=localhost:9000
# Minio__PublicEndpoint=localhost:9000
# Minio__AccessKey=minioadmin
# Minio__SecretKey=minioadmin
# Minio__Bucket=templateapp
# Minio__Secure=false
# Minio__PublicSecure=false
# Minio__PresignedExpirySeconds=900

# Gemini (default when --ai gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alternative ASP.NET section convention:
# Gemini__ApiKey=replace-me
# Gemini__Model=gemini-3.8-flash

# OpenAI (only when --ai openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Alternative ASP.NET section convention:
# OpenAI__ApiKey=replace-me
# OpenAI__Model=gpt-5.6-terra
