# Development environment example for TemplateApp.
# Copy this file to `.env` and adjust values for your machine.
# Docker Compose reads `.env` automatically for interpolation.
# The generated API also loads this file before WebApplication.CreateBuilder for local development.
# Existing OS environment variables and canonical ASP.NET keys win over aliases from this file.

ASPNETCORE_ENVIRONMENT=Development
AUTO_MIGRATE=true

# Database: uncomment the one matching the generated project when running the API directly.
# SQL Server
# DB_CONNECTION=Server=localhost,1433;Database=TemplateApp;User Id=sa;Password=TemplateStrong!123;TrustServerCertificate=True
# PostgreSQL
# DB_CONNECTION=Host=localhost;Port=5432;Database=TemplateApp;Username=postgres;Password=postgres
# DB_PASSWORD=

# JWT / refresh-token auth
JWT_ISSUER=TemplateApp
JWT_AUDIENCE=TemplateApp.Client
JWT_KEY=TemplateApp-development-only-key-change-me-1234567890
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=refresh_token

# Redis (only when --redis true)
# REDIS_CONNECTION=localhost:6379
# REDIS_INSTANCE_NAME=TemplateApp:

# MinIO (only when --minio true)
# MINIO_ENDPOINT=localhost:9000
# MINIO_PUBLIC_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=templateapp
# MINIO_SECURE=false
# MINIO_PUBLIC_SECURE=false
# MINIO_PRESIGNED_EXPIRY_SECONDS=900

# Gemini (default when --ai gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (only when --ai openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
