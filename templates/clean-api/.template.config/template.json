{
  "$schema": "http://json.schemastore.org/template",
  "author": "JohnVo",
  "classifications": [
    "Web",
    "API",
    "DDD",
    "Clean Architecture",
    "Vertical Slice",
    "CQRS"
  ],
  "identity": "JohnVo.ProjectTemplates.DddCleanApi",
  "groupIdentity": "JohnVo.ProjectTemplates.DddCleanApi",
  "name": "JohnVo DDD Clean API",
  "shortName": "jv-api",
  "sourceName": "TemplateApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "description": "Target .NET framework. Supports .NET 8 and newer.",
      "choices": [
        {
          "choice": "net8.0",
          "description": ".NET 8"
        },
        {
          "choice": "net9.0",
          "description": ".NET 9"
        },
        {
          "choice": "net10.0",
          "description": ".NET 10 (default / current LTS)"
        }
      ]
    },
    "frontend": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "description": "Frontend to generate.",
      "choices": [
        {
          "choice": "none",
          "description": "Backend only"
        },
        {
          "choice": "angular",
          "description": "Angular SPA"
        },
        {
          "choice": "react",
          "description": "React + Vite SPA"
        }
      ]
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "sqlserver",
      "description": "EF Core database provider.",
      "choices": [
        {
          "choice": "sqlserver",
          "description": "Microsoft SQL Server"
        },
        {
          "choice": "postgresql",
          "description": "PostgreSQL via Npgsql"
        }
      ]
    },
    "redis": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add Redis distributed cache."
    },
    "docker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add Dockerfiles and compose.yaml."
    },
    "filter": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add VietWash-style LHS-bracket filtering, keyword search, sorting, page/cursor pagination."
    },
    "minio": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add MinIO / S3-compatible object storage integration."
    },
    "ai": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "gemini",
      "description": "AI provider integration. Gemini is enabled by default.",
      "choices": [
        {
          "choice": "gemini",
          "description": "Google Gemini via Google.GenAI (default)"
        },
        {
          "choice": "openai",
          "description": "OpenAI via the official OpenAI .NET SDK"
        },
        {
          "choice": "none",
          "description": "Do not generate AI provider integration"
        }
      ]
    },
    "otel": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add OpenTelemetry traces, metrics and logs exported through OTLP."
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "_variants/**/*",
        ".template.config/**/*",
        "**/[Bb]in/**",
        "**/[Oo]bj/**"
      ]
    },
    {
      "source": "_variants/framework/net8.0",
      "target": "./",
      "condition": "(framework == \"net8.0\")"
    },
    {
      "source": "_variants/framework/net9.0",
      "target": "./",
      "condition": "(framework == \"net9.0\")"
    },
